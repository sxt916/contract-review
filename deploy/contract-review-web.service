[Unit]
Description=Contract Review Web
After=network.target

[Service]
Type=simple
User=contract-review
WorkingDirectory=/opt/contract-review
EnvironmentFile=/etc/contract-review.env
ExecStart=/opt/contract-review/.venv/bin/uvicorn contract_review.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

